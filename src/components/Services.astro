---
const pillars = [
  {
    name: "Security",
    description:
      "Security is part of the system: the request path, the data, and the place it runs. Cryptologists and cybersecurity experts on our advisory board sit behind that work.",
  },
  {
    name: "Scalability",
    description:
      "Systems built to take real-time traffic and keep serving when it surges, from exchange-scale request rates to global ad delivery.",
  },
  {
    name: "Cost effectiveness",
    description:
      "Architecture and infrastructure chosen so performance at that volume stays affordable, on a private cloud or a public cloud as the economics require.",
  },
];
---

<section class="section services" id="capabilities" aria-labelledby="capabilities-title">
  <div class="container">
    <header class="intro reveal">
      <span class="section-label">Capabilities</span>
      <h2 class="section-title" id="capabilities-title">Secure, scalable, and cost&#8209;effective.</h2>
      <p class="section-lead">
        We build the whole system — the path the traffic takes, the infrastructure under it, and
        the cost of keeping it there.
      </p>
    </header>
    <ul class="pillar-list">
      {
        pillars.map((pillar) => (
          <li class="reveal">
            <h3>{pillar.name}</h3>
            <p>{pillar.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services {
    border-block: 1px solid var(--line);
    background:
      radial-gradient(ellipse 50% 80% at 100% 50%, rgba(56, 189, 248, 0.06), transparent 55%),
      var(--bg);
  }

  .intro {
    margin-bottom: var(--space-xl);
  }

  .intro .section-title {
    max-width: 20ch;
  }

  .intro .section-lead {
    max-width: 42ch;
  }

  .pillar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .pillar-list h3 {
    font-size: 1.35rem;
    margin-bottom: 0.65rem;
  }

  .pillar-list p {
    color: var(--ink-muted);
  }

  @media (max-width: 800px) {
    .pillar-list {
      grid-template-columns: 1fr;
    }
  }
</style>
