<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact-inner reveal">
    <span class="section-label">Contact</span>
    <h2 class="section-title" id="contact-title">Let’s talk about the system.</h2>
    <p class="section-lead">
      Tell us the traffic it has to carry, the security it has to hold, and the cost it has to
      stay inside. We’ll reply with how we would build it.
    </p>
    <a class="btn btn-primary contact-cta" href="mailto:hello@nitroxstudios.com">
      hello@nitroxstudios.com
    </a>
  </div>
</section>

<style>
  .contact {
    padding-bottom: var(--space-xl);
  }

  .contact-inner {
    max-width: 40rem;
  }

  .contact .section-title,
  .contact .section-lead {
    max-width: 28ch;
  }

  .contact .section-lead {
    max-width: 46ch;
  }

  .contact-cta {
    margin-top: 1.75rem;
  }
</style>
