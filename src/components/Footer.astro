---
interface Props {
  audience?: "commercial" | "government";
}

const { audience = "commercial" } = Astro.props;
const year = new Date().getFullYear();
const home = audience === "government" ? "/government" : "/";
const links =
  audience === "government"
    ? [
        { href: "/government#competencies", label: "Competencies" },
        { href: "/government#infrastructure", label: "Infrastructure" },
        { href: "/government#performance", label: "Past performance" },
        { href: "/government#security", label: "Security" },
        { href: "/government#contact", label: "Contact" },
      ]
    : [
        { href: "/#systems", label: "Systems" },
        { href: "/#infrastructure", label: "Infrastructure" },
        { href: "/#advisory", label: "Advisory" },
        { href: "/government", label: "Government" },
        { href: "/software", label: "Software", quiet: true },
        { href: "/#contact", label: "Contact" },
      ];
---

<footer class="footer">
  <div class="container footer-inner">
    <a class="brand" href={home}>
      <img src="/brand/logo-mark.svg" width="22" height="22" alt="" decoding="async" />
      Nitrox Studios
    </a>
    <nav class="footer-links" aria-label="Footer">
      {
        links.map((link) => (
          <a href={link.href} class={link.quiet ? "footer-quiet" : undefined}>
            {link.label}
          </a>
        ))
      }
      <a href="mailto:hello@nitroxstudios.com">hello@nitroxstudios.com</a>
    </nav>
    <p class="copy">
      &copy; {year} Nitrox Studios LLC
      <span class="uei">SAM.gov UEI <code>RCEXYHX2NBH7</code></span>
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 2.5rem 3rem;
    border-top: 1px solid var(--line);
    background: #040c12;
  }

  .footer-inner {
    display: grid;
    gap: 1.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    width: fit-content;
  }

  .brand img {
    width: 1.35rem;
    height: 1.35rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
  }

  .footer-links a {
    color: var(--ink-muted);
    font-size: 0.9rem;
    transition: color 0.2s var(--ease);
  }

  .footer-links a:hover {
    color: var(--teal-bright);
  }

  .footer-links a.footer-quiet {
    color: var(--steel);
  }

  .copy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    color: var(--steel);
    font-size: 0.85rem;
  }

  .uei code {
    font-family: ui-monospace, "Cascadia Code", "Segoe UI Mono", monospace;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
</style>
