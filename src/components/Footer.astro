---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <a class="brand" href="/">
      <img src="/brand/logo-mark.svg" width="22" height="22" alt="" decoding="async" />
      Nitrox Studios
    </a>
    <nav class="footer-links" aria-label="Footer">
      <a href="/#systems">Systems</a>
      <a href="/#infrastructure">Infrastructure</a>
      <a href="/#advisory">Advisory</a>
      <a class="footer-quiet" href="/software">Software</a>
      <a href="/#contact">Contact</a>
      <a href="mailto:hello@nitroxstudios.com">hello@nitroxstudios.com</a>
    </nav>
    <p class="copy">&copy; {year} Nitrox Studios</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 2.5rem 3rem;
    border-top: 1px solid var(--line);
    background: #040c12;
  }

  .footer-inner {
    display: grid;
    gap: 1.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    width: fit-content;
  }

  .brand img {
    width: 1.35rem;
    height: 1.35rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
  }

  .footer-links a {
    color: var(--ink-muted);
    font-size: 0.9rem;
    transition: color 0.2s var(--ease);
  }

  .footer-links a:hover {
    color: var(--teal-bright);
  }

  .footer-links a.footer-quiet {
    color: var(--steel);
  }

  .copy {
    color: var(--steel);
    font-size: 0.85rem;
  }
</style>
