---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="brand">
      <img src="/brand/logo-mark.svg" width="22" height="22" alt="" decoding="async" />
      Nitrox Studios
    </p>
    <nav class="footer-links" aria-label="Footer">
      <a href="#products">Products</a>
      <a href="https://bkkleague.com" target="_blank" rel="noopener noreferrer">Bangkok Pool League</a>
      <a
        href="https://apps.apple.com/th/app/bangkok-pool-league/id6447631894"
        target="_blank"
        rel="noopener noreferrer"
      >iOS app</a>
      <a
        href="https://play.google.com/store/apps/details?id=com.bangkok_pool_league"
        target="_blank"
        rel="noopener noreferrer"
      >Android app</a>
      <a href="https://nitroxstudios.com/aula/">AULA Companion</a>
      <a href="mailto:hello@nitroxstudios.com?subject=OCR%20Core%20Impact">OCR Core Impact</a>
      <a href="https://www.npmjs.com/package/countrycitystatejson" target="_blank" rel="noopener noreferrer">
        countrycitystatejson
      </a>
      <a href="mailto:hello@nitroxstudios.com">Contact</a>
    </nav>
    <p class="copy">&copy; {year} Nitrox Studios</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 2.5rem 3rem;
    border-top: 1px solid var(--line);
    background: #040c12;
  }

  .footer-inner {
    display: grid;
    gap: 1.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
  }

  .brand img {
    width: 1.35rem;
    height: 1.35rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
  }

  .footer-links a {
    color: var(--ink-muted);
    font-size: 0.9rem;
    transition: color 0.2s var(--ease);
  }

  .footer-links a:hover {
    color: var(--teal-bright);
  }

  .copy {
    color: var(--steel);
    font-size: 0.85rem;
  }
</style>
