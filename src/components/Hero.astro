---
---

<section class="hero" id="top" aria-labelledby="brand">
  <div class="hero-atmosphere" aria-hidden="true">
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="grid"></div>
    <div class="depth"></div>
  </div>

  <div class="container hero-layout">
    <div class="hero-content">
      <h1 class="brand" id="brand">Nitrox Studios</h1>
      <p class="headline">Software engineered for the real world.</p>
      <p class="support">
        We design and build web, mobile, and backend systems that teams rely on every day.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="#products">View products</a>
        <a class="btn btn-ghost" href="#contact">Get in touch</a>
      </div>
    </div>

    <div class="hero-tank" aria-hidden="true">
      <img
        class="tank-art"
        src="/brand/nitrox-tank.svg"
        alt=""
        width="280"
        height="520"
        decoding="async"
      />
      <div class="tank-glow"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: 5.5rem;
    padding-bottom: clamp(3rem, 8vh, 5rem);
    overflow: hidden;
  }

  .hero-atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 80% 55% at 70% 15%, rgba(46, 196, 182, 0.18), transparent 55%),
      radial-gradient(ellipse 60% 50% at 10% 80%, rgba(56, 189, 248, 0.12), transparent 50%),
      linear-gradient(165deg, #041018 0%, #0a1c28 45%, #07141c 100%);
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.7;
    animation: drift 18s ease-in-out infinite alternate;
  }

  .orb-a {
    width: min(48vw, 28rem);
    height: min(48vw, 28rem);
    top: 8%;
    right: 5%;
    background: radial-gradient(circle, rgba(46, 196, 182, 0.45), transparent 70%);
  }

  .orb-b {
    width: min(40vw, 22rem);
    height: min(40vw, 22rem);
    bottom: 10%;
    left: -5%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.3), transparent 70%);
    animation-delay: -6s;
    animation-duration: 22s;
  }

  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(122, 147, 163, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(122, 147, 163, 0.07) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black, transparent 75%);
    animation: grid-shift 28s linear infinite;
  }

  .depth {
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: linear-gradient(to top, var(--bg-deep), transparent);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    width: min(100% - 2.5rem, var(--max));
  }

  .hero-content {
    max-width: 40rem;
    position: relative;
    z-index: 1;
  }

  .hero-tank {
    position: relative;
    justify-self: end;
    width: min(100%, 22rem);
    margin-right: clamp(0rem, 2vw, 1.5rem);
    animation: tank-in 1.15s var(--ease) 0.2s both;
  }

  .tank-art {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 28px 48px rgba(0, 0, 0, 0.55));
    animation: tank-float 7s ease-in-out infinite;
  }

  .tank-glow {
    position: absolute;
    inset: 18% 8% 6%;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(46, 196, 182, 0.28), transparent 68%);
    filter: blur(18px);
    animation: glow-pulse 5.5s ease-in-out infinite;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 8vw, 5.25rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0 0 1.25rem;
    background: linear-gradient(120deg, var(--ink) 20%, var(--teal-bright) 55%, var(--cyan) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: brand-in 1s var(--ease) both;
  }

  .headline {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.2vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink);
    max-width: 22ch;
    margin: 0 0 1rem;
    animation: rise 0.9s var(--ease) 0.15s both;
  }

  .support {
    color: var(--ink-muted);
    font-size: 1.1rem;
    max-width: 36ch;
    margin-bottom: 1.75rem;
    animation: rise 0.9s var(--ease) 0.28s both;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    animation: rise 0.9s var(--ease) 0.4s both;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-4%, 6%, 0) scale(1.08);
    }
  }

  @keyframes grid-shift {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 72px 72px;
    }
  }

  @keyframes brand-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes tank-in {
    from {
      opacity: 0;
      transform: translate3d(1.5rem, 1rem, 0) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes tank-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.65rem);
    }
  }

  @keyframes glow-pulse {
    0%,
    100% {
      opacity: 0.75;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }

  @media (max-width: 860px) {
    .hero-layout {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .hero-tank {
      position: absolute;
      right: -8%;
      bottom: 4%;
      width: min(42vw, 11rem);
      margin: 0;
      opacity: 0.55;
      pointer-events: none;
      z-index: 0;
    }

    .hero-content {
      max-width: 34rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb,
    .grid,
    .brand,
    .headline,
    .support,
    .cta,
    .hero-tank,
    .tank-art,
    .tank-glow {
      animation: none;
    }

    .brand {
      filter: none;
      opacity: 1;
    }
  }
</style>
