---
import NetworkGraphic from "./NetworkGraphic.astro";

const places = [
  {
    name: "Private cloud",
    description:
      "Secure data centers on the east coast in Ashburn, Virginia, on the west coast in Los Angeles and Santa Clara, and in Europe in Amsterdam and Haarlem. Geo-directional load balancing sent each request to the nearest site.",
  },
  {
    name: "Global CDN",
    description:
      "A global CDN sat in front of that private cloud and distributed content to the audience in under 100 ms.",
  },
  {
    name: "Public cloud",
    description:
      "AWS, Azure, and Google Cloud, when regional reach and elastic capacity are the better fit for the traffic.",
  },
];
---

<section class="section infrastructure" id="infrastructure" aria-labelledby="infrastructure-title">
  <div class="container">
    <header class="intro reveal">
      <div>
        <span class="section-label">Infrastructure</span>
        <h2 class="section-title" id="infrastructure-title">A private cloud across three regions.</h2>
        <p class="section-lead">
          The private cloud ran in secure data centers on the east coast, the west coast, and in
          Europe. Geo-directional load balancing and a global CDN distributed content to the
          audience in under 100 ms.
        </p>
      </div>
      <ul class="sites" aria-label="Private cloud sites">
        <li>Ashburn, Virginia</li>
        <li>Los Angeles</li>
        <li>Santa Clara</li>
        <li>Amsterdam and Haarlem</li>
      </ul>
    </header>

    <div class="map reveal" aria-hidden="true">
      <NetworkGraphic variant="sites" />
    </div>

    <ul class="place-list">
      {
        places.map((place) => (
          <li class="reveal">
            <h3>{place.name}</h3>
            <p>{place.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .infrastructure .section-title {
    max-width: 16ch;
  }

  .infrastructure .section-lead {
    max-width: 48ch;
  }

  .infrastructure {
    background:
      radial-gradient(ellipse 45% 70% at 100% 20%, rgba(46, 196, 182, 0.08), transparent 55%),
      var(--bg-deep);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) auto;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
    margin-bottom: var(--space-lg);
  }

  .sites {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .sites li {
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .sites li::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.55rem;
    border-radius: 50%;
    background: var(--teal-bright);
    box-shadow: 0 0 8px rgba(46, 196, 182, 0.65);
  }

  .map {
    margin-bottom: var(--space-lg);
    padding: clamp(0.5rem, 2vw, 1.25rem) clamp(0.25rem, 2vw, 1rem) 0.25rem;
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background:
      radial-gradient(ellipse 40% 80% at 20% 40%, rgba(46, 196, 182, 0.08), transparent 60%),
      radial-gradient(ellipse 35% 70% at 80% 30%, rgba(56, 189, 248, 0.08), transparent 55%),
      var(--bg-elevated);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
  }

  .place-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .place-list li {
    padding: 1.35rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--surface);
  }

  .place-list h3 {
    font-size: 1.25rem;
    margin-bottom: 0.45rem;
  }

  .place-list p {
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .intro,
    .place-list {
      grid-template-columns: 1fr;
    }
  }
</style>
