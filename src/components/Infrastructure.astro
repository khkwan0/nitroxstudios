---
const places = [
  {
    name: "Private cloud",
    description:
      "Private clouds inside secure data centers, when the system needs isolation and a cost you can plan against at steady, high volume.",
  },
  {
    name: "Public cloud",
    description:
      "AWS, Azure, and Google Cloud, when regional reach and elastic capacity are the better fit for the traffic.",
  },
];
---

<section class="section infrastructure" id="infrastructure" aria-labelledby="infrastructure-title">
  <div class="container infra-inner">
    <div class="reveal">
      <span class="section-label">Infrastructure</span>
      <h2 class="section-title" id="infrastructure-title">Private clouds and public cloud.</h2>
      <p class="section-lead">
        We place each system where the security requirement and the cost of the traffic both
        hold: a private cloud in a secure data center, or AWS, Azure, and Google Cloud.
      </p>
    </div>
    <ul class="place-list">
      {
        places.map((place) => (
          <li class="reveal">
            <h3>{place.name}</h3>
            <p>{place.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .infrastructure .section-title {
    max-width: 16ch;
  }

  .infrastructure .section-lead {
    max-width: 42ch;
  }

  .infrastructure {
    background:
      radial-gradient(ellipse 45% 70% at 100% 80%, rgba(46, 196, 182, 0.07), transparent 55%),
      var(--bg-deep);
  }

  .infra-inner {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .place-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .place-list li {
    padding: 1.35rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--surface);
  }

  .place-list h3 {
    font-size: 1.25rem;
    margin-bottom: 0.45rem;
  }

  .place-list p {
    color: var(--ink-muted);
  }

  @media (max-width: 760px) {
    .infra-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
