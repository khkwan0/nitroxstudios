---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Proof from "../components/Proof.astro";
import Systems from "../components/Systems.astro";
import Services from "../components/Services.astro";
import Infrastructure from "../components/Infrastructure.astro";
import Advisory from "../components/Advisory.astro";
import SoftwareNote from "../components/SoftwareNote.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const title = "Nitrox Studios — Scalable, Secure Real-Time Systems";
const description =
  "Nitrox Studios builds complete, scalable, secure systems for massive real-time traffic. An ad exchange at millions of HTTP requests per second. A global ad server at 100,000 hits per second. Private clouds in secure data centers, and AWS, Azure, and Google Cloud.";
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <Nav />
  <main id="main">
    <Hero />
    <Proof />
    <Systems />
    <Services />
    <Infrastructure />
    <Advisory />
    <SoftwareNote />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
