---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Products from "../components/Products.astro";
import Services from "../components/Services.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const title = "Nitrox Studios — Software Engineering Company";
const description =
  "Nitrox Studios builds production software: Bangkok Pool League, AULA S98 Pro Companion, OCR Core Impact, Duck Huntr, shitsue, countrycitystatejson, and Meme Canvas. Custom web, mobile, and backend engineering.";
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <Nav />
  <main id="main">
    <Hero />
    <Products />
    <Services />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
