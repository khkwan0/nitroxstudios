---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — Nitrox Studios">
  <main class="missing">
    <div class="container">
      <p class="brand">Nitrox Studios</p>
      <h1>Page not found</h1>
      <p>That URL doesn’t exist on this site.</p>
      <a class="btn btn-primary" href="/">Back home</a>
    </div>
  </main>
</BaseLayout>

<style>
  .missing {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: 6rem 4rem;
    background:
      radial-gradient(ellipse 60% 50% at 70% 20%, rgba(46, 196, 182, 0.15), transparent 55%),
      var(--bg-deep);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--teal-bright);
    margin-bottom: 1rem;
  }

  h1 {
    margin-bottom: 0.75rem;
  }

  p {
    color: var(--ink-muted);
    margin-bottom: 1.5rem;
  }
</style>
