---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogType?: string;
  imageAlt?: string;
}

const SITE = "https://nitroxstudios.com";
const DEFAULT_DESCRIPTION =
  "Nitrox Studios builds complete, scalable, secure systems for massive real-time traffic. An ad exchange at millions of HTTP requests per second. A global ad server at 100,000 hits per second. Private clouds in secure data centers, and AWS, Azure, and Google Cloud.";

const DEFAULT_IMAGE_ALT = "Nitrox Studios — Systems built for massive, real-time traffic";

const {
  title = "Nitrox Studios — Scalable, Secure Real-Time Systems",
  description = DEFAULT_DESCRIPTION,
  canonicalPath = "/",
  noindex = false,
  ogType = "website",
  imageAlt = DEFAULT_IMAGE_ALT,
} = Astro.props;

const canonical = new URL(canonicalPath, SITE).href;
const ogImage = new URL("/og-image.png", SITE).href;

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Nitrox Studios",
  url: SITE,
  logo: new URL("/brand/logo-mark.svg", SITE).href,
  description: DEFAULT_DESCRIPTION,
  email: "hello@nitroxstudios.com",
  sameAs: [
    "https://bkkleague.com",
    "https://nitroxstudios.com/aula/",
    "https://nitroxstudios.com/meme/",
    "https://shitsue.com",
    "https://github.com/khkwan0/umpire",
    "https://github.com/khkwan0/duckhuntr",
    "https://www.npmjs.com/package/countrycitystatejson",
    "https://github.com/khkwan0/countryCityStateJson",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    email: "hello@nitroxstudios.com",
    contactType: "sales",
  },
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Nitrox Studios",
  url: SITE,
  description: DEFAULT_DESCRIPTION,
  publisher: {
    "@type": "Organization",
    name: "Nitrox Studios",
    url: SITE,
  },
};

const jsonLd = [organizationLd, websiteLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="author" content="Nitrox Studios" />
    <meta name="theme-color" content="#061018" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content="Nitrox Studios" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/og-image.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <script is:inline src="/reveal.js"></script>
  </body>
</html>
